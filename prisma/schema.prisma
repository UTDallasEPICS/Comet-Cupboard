generator client {
    provider = "prisma-client"
    output   = "./generated/prisma"
}

datasource db {
    provider = "sqlite"
}

enum RoleType {
    STUDENT
    VOLUNTEER
    ADMIN
    HEAD_ADMIN
}

enum BagCategory {
    VEGETARIAN_AND_PEANUT_BUTTER
    VEGETARIAN_AND_NON_PEANUT_BUTTER
    NONVEGETARIAN_AND_PEANUT_BUTTER
    NONVEGETARIAN_AND_NON_PEANUT_BUTTER
}

model RoleRequest {
    userID String   @id @map("user_id")
    User   User     @relation(fields: [userID], references: [netID], onDelete: Cascade, onUpdate: Cascade)
    role   RoleType @map("role")

    @@map("role_request")
}

model User {
    netID       String       @id @map("net_id")
    role        RoleType     @map("role")
    roleRequest RoleRequest?
    Cart        Cart?
    Orders      Order[]
    QueueEntry  QueueEntry?

    @@map("user")
}

model Category {
    name  String @id @map("name")
    Items Item[]

    @@map("category")
}

model Item {
    itemID            String                   @id @default(cuid()) @map("item_id")
    name              String                   @map("name")
    Category          Category                 @relation(fields: [categoryName], references: [name], onDelete: Restrict, onUpdate: Cascade)
    categoryName      String                   @map("category_name")
    quantity          Int                      @default(0) @map("quantity")
    Deal              Deal?
    imgName           String                   @map("img_name")
    ItemCountChanges  ItemCountChange[]
    CartItems         CartItem[]
    OrderItems        OrderItem[]
    archived          Boolean                  @default(false)
    createdAt         DateTime                 @default(now()) @map("created_at")
    EmergencyBagItems EmergencyBagItem[]
    IssuedBagItems    IssuedEmergencyBagItem[]

    @@map("item")
}

model ItemCountChange {
    countChangeID String   @id @default(cuid()) @map("count_change_id")
    date          DateTime @default(now()) @map("date")
    amountChanged Int      @map("amount_changed")
    Item          Item     @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID        String   @map("item_id")
    Source        Source   @relation(fields: [sourceName], references: [name], onDelete: Restrict, onUpdate: Cascade)
    sourceName    String   @map("source_name")
    fieldMap      Json?    @map("field_map")

    @@map("item_count_change")
}

model Field {
    fieldID    String @id @default(cuid()) @map("field_id")
    name       String
    Source     Source @relation(fields: [sourceName], references: [name], onDelete: Restrict, onUpdate: Cascade)
    sourceName String @map("source_name")

    @@map("field")
}

model Source {
    sourceID         String            @id @default(cuid()) @map("source_id")
    name             String            @unique @map("name")
    ItemCountChanges ItemCountChange[]
    Fields           Field[]
    archived         Boolean           @default(false) @map("archived")

    @@map("source")
}

model Cart {
    User      User       @relation(fields: [cartID], references: [netID], onDelete: Cascade, onUpdate: Cascade)
    cartID    String     @id @map("cart_id")
    joinedAt  DateTime   @default(now()) @map("joined_at")
    CartItems CartItem[]
    pending   Boolean    @default(false) @map("pending")

    @@map("cart")
}

model CartItem {
    Item            Item   @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID          String @map("item_id")
    Cart            Cart   @relation(fields: [cartID], references: [cartID], onDelete: Cascade, onUpdate: Cascade)
    cartID          String @map("cart_id")
    count           Int    @map("count")
    // Fields to track adjustments to decrease from total count
    countAdjustment Int    @default(0) @map("count_adjustment")

    @@id(name: "cartItemID", [itemID, cartID])
    @@map("cart_item")
}

model Order {
    orderID    String      @id @default(cuid()) @map("order_id")
    User       User        @relation(fields: [netID], references: [netID], onDelete: NoAction, onUpdate: Cascade)
    netID      String      @map("net_id")
    date       DateTime    @default(now()) @map("date")
    OrderItems OrderItem[]

    @@map("order")
}

model OrderItem {
    Item    Item   @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID  String @map("item_id")
    Order   Order  @relation(fields: [orderID], references: [orderID], onDelete: Restrict, onUpdate: Cascade)
    orderID String @map("order_id")
    count   Int    @map("count")

    @@id(name: "orderItemID", [itemID, orderID])
    @@map("order_item")
}

model Deal {
    Item          Item   @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID        String @id @map("item_id")
    actualCount   Int    @map("actual_count")
    adjustedCount Int    @map("adjusted_count")

    @@map("deal")
}

model QueueEntry {
    netID      String   @id @map("net_id")
    publicCode String   @map("public_code")
    joinedAt   DateTime @default(now()) @map("joined_at")
    position   Int      @map("position")
    User       User     @relation(fields: [netID], references: [netID])

    @@map("queue_entry")
}

model EmergencyBag {
    bagID             String             @id @default(cuid()) @map("bag_id")
    Location          Location?          @relation(fields: [locationName], references: [name], onDelete: Restrict, onUpdate: Cascade)
    locationName      String?
    bagCategory       BagCategory        @map("bag_category")
    EmergencyBagItems EmergencyBagItem[]
    bagDescription    String?            @map("bag_description")
    expiryDate        DateTime           @map("expiry_date")
    // 5 digit ID for volunteers/students
    label             String             @unique

    @@map("emergency_bag")
}

model Location {
    name                String               @id @map("name")
    EmergencyBags       EmergencyBag[]
    IssuedEmergencyBags IssuedEmergencyBag[]
    address             String               @map("address")
    archived            Boolean              @default(false) @map("archived")

    @@map("location")
}

model EmergencyBagItem {
    Item         Item         @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID       String       @map("item_id")
    bagID        String       @map("bag_id")
    EmergencyBag EmergencyBag @relation(fields: [bagID], references: [bagID], onDelete: Cascade, onUpdate: Cascade)
    itemCount    Int          @map("count")

    @@id(name: "emergencyBagItemID", [itemID, bagID])
    @@map("bag_item")
}

//Table for Issued bags (archive)

model IssuedEmergencyBag {
    bagID             String                   @id @default(cuid()) @map("bag_id")
    Location          Location                 @relation(fields: [location], references: [name], onDelete: Restrict, onUpdate: Cascade)
    location          String
    bagCategory       BagCategory              @map("bag_category")
    EmergencyBagItems IssuedEmergencyBagItem[]
    bagDescription    String?                  @map("bag_description")
    expiryDate        DateTime                 @map("expiry_date")
    //5 digit ID for volunteers/students
    label             String                   @unique

    @@map("issued_emergency_bag")
}

//Table for issued Bag items
model IssuedEmergencyBagItem {
    Item               Item               @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID             String             @map("item_id")
    bagID              String             @map("bag_id")
    IssuedEmergencyBag IssuedEmergencyBag @relation(fields: [bagID], references: [bagID], onDelete: Cascade, onUpdate: Cascade)
    itemCount          Int                @map("count")

    @@id(name: "emergencyBagItemID", [itemID, bagID])
    @@map("issued_bag_item")
}
