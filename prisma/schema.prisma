generator client {
    provider = "prisma-client"
    output   = "./generated/prisma"
}

datasource db {
    provider = "sqlite"
}

enum RoleType {
    STUDENT
    VOLUNTEER
    ADMIN
    HEAD_ADMIN
}

enum Privacy {
    PUBLIC
    PRIVATE
}

model User {
    userID      String       @id @map("userID")
    displayName String       @default("") @map("display_name")
    role        RoleType     @map("role")
    Orders      Order[]
    userSession UserSession?

    @@map("user")
}

model UserSession {
    userID                 String                  @id @map("userID")
    User                   User                    @relation(fields: [userID], references: [userID], onDelete: Cascade, onUpdate: Cascade)
    publicCode             String                  @unique @map("public_code")
    publicIcon             String                  @map("public_icon")
    Cart                   Cart?
    QueueEntry             QueueEntry?
    InventoryChangeSession InventoryChangeSession?

    @@map("user_session")
}

model Category {
    categoryID String  @id @default(cuid()) @map("id")
    name       String  @unique @map("name")
    imgName    String  @map("img_name")
    archived   Boolean @default(false) @map("archived")
    Items      Item[]

    @@map("category")
}

model Item {
    itemID                      String                       @id @default(cuid()) @map("item_id")
    name                        String                       @unique @map("name")
    Category                    Category                     @relation(fields: [categoryName], references: [name], onDelete: Restrict, onUpdate: Cascade)
    categoryName                String                       @map("category_name")
    quantity                    Int                          @default(0) @map("quantity")
    Deal                        Deal?
    imgName                     String                       @map("img_name")
    ItemCountChanges            ItemCountChange[]
    InventoryChangeSessionItems InventoryChangeSessionItem[]
    CartItems                   CartItem[]
    OrderItems                  OrderItem[]
    archived                    Boolean                      @default(false) @map("archived")
    createdAt                   DateTime                     @default(now()) @map("created_at")
    EmergencyBagItems           EmergencyBagItem[]
    IssuedEmergencyBagItems     IssuedEmergencyBagItem[]

    @@map("item")
}

model ItemCountChange {
    countChangeID String   @id @default(cuid()) @map("count_change_id")
    date          DateTime @default(now()) @map("date")
    amountChanged Int      @map("amount_changed")
    Item          Item     @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID        String   @map("item_id")
    Source        Source   @relation(fields: [sourceID], references: [sourceID], onDelete: Restrict, onUpdate: Cascade)
    sourceID      String   @map("source_id")
    fieldMap      Json?    @map("field_map")

    @@map("item_count_change")
}

model Field {
    fieldID  String @id @default(cuid()) @map("field_id")
    name     String
    Source   Source @relation(fields: [sourceID], references: [sourceID], onDelete: Restrict, onUpdate: Cascade)
    sourceID String @map("source_id")

    @@map("field")
}

model Source {
    sourceID         String            @id @default(cuid()) @map("source_id")
    name             String            @unique @map("name")
    ItemCountChanges ItemCountChange[]
    Fields           Field[]
    archived         Boolean           @default(false) @map("archived")

    @@map("source")
}

model InventoryChangeSession {
    publicCode                  String                       @id @map("public_code")
    UserSession                 UserSession                  @relation(fields: [publicCode], references: [publicCode], onDelete: Cascade, onUpdate: Cascade)
    InventoryChangeSessionItems InventoryChangeSessionItem[]

    @@map("inventory_change_session")
}

model InventoryChangeSessionItem {
    InventoryChangeSession InventoryChangeSession @relation(fields: [publicCode], references: [publicCode], onDelete: Cascade, onUpdate: Cascade)
    publicCode             String                 @map("public_code")
    Item                   Item                   @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID                 String                 @map("item_id")
    count                  Int                    @map("count")

    @@id(name: "inventoryChangeSessionItemID", [publicCode, itemID])
    @@map("inventory_change_session_item")
}

model Cart {
    UserSession UserSession @relation(fields: [publicCode], references: [publicCode], onDelete: Cascade, onUpdate: Cascade)
    publicCode  String      @id @map("public_code")
    createdAt   DateTime    @default(now()) @map("created_at")
    CartItems   CartItem[]
    pending     Boolean     @default(false) @map("pending")

    @@map("cart")
}

model CartItem {
    Cart            Cart   @relation(fields: [publicCode], references: [publicCode], onDelete: Cascade, onUpdate: Cascade)
    publicCode      String @map("public_code")
    Item            Item   @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID          String @map("item_id")
    count           Int    @map("count")
    // Fields to track adjustments to decrease from total count
    countAdjustment Int    @default(0) @map("count_adjustment")

    @@id(name: "cartItemID", [itemID, publicCode])
    @@map("cart_item")
}

model Order {
    orderID       String      @id @default(cuid()) @map("order_id")
    User          User        @relation(fields: [userID], references: [userID], onDelete: NoAction, onUpdate: Cascade)
    userID        String      @map("userID")
    cartCreatedAt DateTime    @map("cart_created_at")
    createdAt     DateTime    @default(now()) @map("created_at")
    OrderItems    OrderItem[]

    @@map("order")
}

model OrderItem {
    Item    Item   @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID  String @map("item_id")
    Order   Order  @relation(fields: [orderID], references: [orderID], onDelete: Restrict, onUpdate: Cascade)
    orderID String @map("order_id")
    count   Int    @map("count")

    @@id(name: "orderItemID", [itemID, orderID])
    @@map("order_item")
}

model Deal {
    Item          Item   @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID        String @id @map("item_id")
    actualCount   Int    @map("actual_count")
    adjustedCount Int    @map("adjusted_count")

    @@map("deal")
}

model QueueEntry {
    UserSession UserSession @relation(fields: [publicCode], references: [publicCode], onDelete: Cascade, onUpdate: Cascade)
    publicCode  String      @id @map("public_code")
    joinedAt    DateTime    @default(now()) @map("joined_at")
    position    Int         @map("position")

    @@map("queue_entry")
}

model Location {
    name                String               @id @map("name")
    EmergencyBags       EmergencyBag[]
    IssuedEmergencyBags IssuedEmergencyBag[]
    description         String               @map("description")
    archived            Boolean              @default(false) @map("archived")
    imgName             String               @map("img_name")

    @@map("location")
}

model EmergencyBag {
    bagID             String             @id @default(cuid()) @map("bag_id")
    Location          Location?          @relation(fields: [locationName], references: [name], onDelete: Restrict, onUpdate: Cascade)
    locationName      String?
    isVegetarian      Boolean            @default(false) @map("is_vegetarian")
    hasPeanutButter   Boolean            @default(false) @map("has_peanut_butter")
    privacy           Privacy            @default(PUBLIC) @map("privacy")
    EmergencyBagItems EmergencyBagItem[]
    bagDescription    String?            @default("") @map("bag_description")
    expiryDate        DateTime           @map("expiry_date")
    // 5 digit ID for volunteers/students
    label             String             @unique

    @@map("emergency_bag")
}

model EmergencyBagItem {
    Item         Item         @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID       String       @map("item_id")
    bagID        String       @map("bag_id")
    EmergencyBag EmergencyBag @relation(fields: [bagID], references: [bagID], onDelete: Cascade, onUpdate: Cascade)
    count        Int          @map("count")

    @@id(name: "emergencyBagItemID", [itemID, bagID])
    @@map("emergency_bag_item")
}

//Table for Issued bags (archive)

model IssuedEmergencyBag {
    bagID             String                   @id @default(cuid()) @map("bag_id")
    Location          Location                 @relation(fields: [location], references: [name], onDelete: Restrict, onUpdate: Cascade)
    location          String
    EmergencyBagItems IssuedEmergencyBagItem[]
    bagDescription    String?                  @default("") @map("bag_description")
    expiryDate        DateTime                 @map("expiry_date")
    //5 digit ID for volunteers/students
    label             String

    @@map("issued_emergency_bag")
}

//Table for issued Bag items
model IssuedEmergencyBagItem {
    Item               Item               @relation(fields: [itemID], references: [itemID], onDelete: Restrict, onUpdate: Cascade)
    itemID             String             @map("item_id")
    bagID              String             @map("bag_id")
    IssuedEmergencyBag IssuedEmergencyBag @relation(fields: [bagID], references: [bagID], onDelete: Cascade, onUpdate: Cascade)
    count              Int                @map("count")

    @@id(name: "emergencyBagItemID", [itemID, bagID])
    @@map("issued_emergency_bag_item")
}

model TutorialGroup {
    id    String         @id @default(cuid())
    name  String         @unique
    pages TutorialPage[]

    @@map("tutorial_group")
}

model TutorialPage {
    id      String         @id @default(cuid())
    name    String
    groupID String
    group   TutorialGroup  @relation(fields: [groupID], references: [id], onDelete: Cascade)
    steps   TutorialStep[]
}

model TutorialStep {
    id          String       @id @default(cuid())
    imageURL    String
    description String
    stepOrdering   Int
    pageID      String
    page        TutorialPage @relation(fields: [pageID], references: [id], onDelete: Cascade)
}
