{
	"plugins": ["@prettier/plugin-pug"],
	"printWidth": 160,
	"endOfLine": "auto",
	"useTabs": true,
	"tabWidth": 4,
	"trailingComma": "es5",
	"semi": false,
	"singleQuote": false,
	"bracketSpacing": true,
	"arrowParens": "always",
	"htmlWhitespaceSensitivity": "css",
	"requirePragma": false,
	"insertPragma": false,
	"quoteProps": "as-needed",
	"proseWrap": "always",
	"pugFramework": "vue",
	"pugAttributeSeparator": "none",
	"pugSortAttributes": "asc",
	"pugSortAttributesBeginning": ["v-show", "v-if", "v-else-if", "v-else", "v-for", ":key", "class"],
	"pugSortAttributesEnd": ["^@.*$", "^:.*$"],
	"pugClassNotation": "literal",
	"pugClassLocation": "after-attributes",
	"pugExplicitDiv": true
}
